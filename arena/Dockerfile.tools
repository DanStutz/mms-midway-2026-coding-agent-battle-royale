FROM node:22-bookworm@sha256:0e5f906573693feaa1e21057ebdcfdb5bd5021f050b2dc7c9deceb629c7da2a8
RUN apt-get update && apt-get install -y --no-install-recommends python3 ripgrep unzip curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex@0.163.0 opencode-ai@1.19.3 && npm install -g --ignore-scripts @earendil-works/pi-coding-agent@1.3.0
RUN mkdir -p /root/.nvm && printf '# Preinstalled Node 22; no nvm installation needed.\n' > /root/.nvm/nvm.sh
RUN codex --version && opencode --version && pi --version
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/arena-aider && /opt/arena-aider/bin/pip install --no-cache-dir aider-chat==0.86.2 && ln -s /opt/arena-aider/bin/aider /usr/local/bin/aider
RUN mkdir -p /root/.local/bin && printf '# Aider is preinstalled in /opt/arena-aider.\n' > /root/.local/bin/env && aider --version
RUN npm install -g cline@3.0.73
RUN python3 -m venv /opt/arena-mini && /opt/arena-mini/bin/pip install --no-cache-dir mini-swe-agent==2.4.6 && ln -s /opt/arena-mini/bin/mini /usr/local/bin/mini-swe-agent
RUN apt-get update && apt-get install -y --no-install-recommends bzip2 libxcb1 libgomp1 && rm -rf /var/lib/apt/lists/*
RUN curl -fLsS https://github.com/aaif-goose/goose/releases/download/v1.52.0/goose-x86_64-unknown-linux-gnu.tar.bz2 -o /tmp/goose.tar.bz2 && mkdir -p /tmp/goose-unpack && tar -xjf /tmp/goose.tar.bz2 -C /tmp/goose-unpack && install /tmp/goose-unpack/goose /usr/local/bin/goose && rm -rf /tmp/goose.tar.bz2 /tmp/goose-unpack
RUN cline --version && /opt/arena-mini/bin/pip show mini-swe-agent && goose --version

RUN /opt/arena-mini/bin/pip install --no-cache-dir mcp==2.3.0 && /opt/arena-mini/bin/python -c "import mcp; from mcp.types import CacheableResult; import litellm"
RUN /opt/arena-mini/bin/python -c "import litellm.experimental_mcp_client.client"

# Native OpenHands SDK and Qwen Code, pinned for repeatable races.
RUN npm install -g @qwen-code/qwen-code@0.26.1 && qwen --version
RUN python3 -m venv /opt/arena-uv && /opt/arena-uv/bin/pip install --no-cache-dir uv==0.13.5
RUN /opt/arena-uv/bin/uv python install 3.12.12 && /opt/arena-uv/bin/uv venv /opt/openhands-sdk-venv --python 3.12.12 && /opt/arena-uv/bin/uv pip install --python /opt/openhands-sdk-venv/bin/python openhands-sdk==1.58.2 openhands-tools==1.58.2 fastapi
RUN /opt/openhands-sdk-venv/bin/python -c "import openhands.sdk; print(openhands.sdk.__version__)"

RUN apt-get update && apt-get install -y --no-install-recommends tmux && rm -rf /var/lib/apt/lists/*
